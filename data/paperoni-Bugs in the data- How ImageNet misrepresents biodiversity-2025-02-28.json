[{"paper_id": "b7cecab479a7e4bdb3bfee9d049c0790", "title": "Bugs in the Data: How ImageNet Misrepresents Biodiversity", "abstract": "ImageNet-1k is a dataset often used for benchmarking machine learning (ML) models and evaluating tasks such as image recognition and object detection. Wild animals make up 27% of ImageNet-1k but, unlike classes representing people and objects, these data have not been closely scrutinized. In the current paper, we analyze the 13,450 images from 269 classes that represent wild animals in the ImageNet-1k validation set, with the participation of expert ecologists. We find that many of the classes are ill-defined or overlapping, and that 12% of the images are incorrectly labeled, with some classes having >90% of images incorrect. We also find that both the wildlife-related labels and images included in ImageNet-1k present significant geographical and cultural biases, as well as ambiguities such as artificial animals, multiple species in the same image, or the presence of humans. Our findings highlight serious issues with the extensive use of this dataset for evaluating ML systems, the use of such algorithms in wildlife-related tasks, and more broadly the ways in which ML datasets are commonly created and curated.", "authors": [{"author": {"author_id": "af31911ee011a9ca902e504c375310ff", "name": "Alexandra Luccioni", "links": [{"type": "semantic_scholar", "link": "2993731"}, {"type": "xplore", "link": "37088340455"}]}, "affiliations": [{"institution_id": "2d64978822ccf8676fd9f98e10c823c2", "name": "McGill University", "category": "unknown"}, {"institution_id": "584f07cf35322150fe0265616e6b8172", "name": "2 McGill University", "category": "academia"}, {"institution_id": "78a83265183550c66a78ff9b5f9b960f", "name": "Mila", "category": "unknown"}]}, {"author": {"author_id": "d542742d418303555e2cfa64f16c6e84", "name": "David Rolnick", "links": [{"type": "bio", "link": "david-rolnick"}, {"type": "email.mila", "link": "drolnick@mila.quebec"}, {"ty